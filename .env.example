# OpenAI API Configuration
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your_openrouter_api_key_here

# SSL Configuration
# Set to False to disable SSL verification (not recommended for production)
OPENAI_SSL_VERIFY=True

# Model Configuration
OPENAI_EXTRACT_MODEL=moonshotai/kimi-k2
OPENAI_TRANSLATION_MODEL=moonshotai/kimi-k2

# Debug Mode
DEBUG=True

# Metabase
METABASE_PORT=3000
METABASE_SITE_URL=http://localhost:3000
METABASE_APP_DB_NAME=metabaseappdb
METABASE_APP_DB_USER=metabase
METABASE_APP_DB_PASSWORD=

# Maps.guru API Configuration
# Get your API key from https://maps.guru/
MAPS_GURU_API_KEY=your_maps_guru_api_key_here

# Required when DEBUG is false. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Comma-separated; localhost is allowed by default
ALLOWED_HOSTS=127.0.0.1,localhost,.localhost
CSRF_TRUSTED_ORIGINS=http://*.localhost:8000

# PostgreSQL (required; the tenant schemas need it). Used by settings and compose
POSTGRES_DB=naari
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Optional: partner visibility rules, see one/settings.py
PARTNER_VISIBILITY_RULES_JSON=[]

# Self-registration (web and GraphQL)
ALLOW_SIGNUP=False
